{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Live logs, error rates, and key auth/email events from the DeepFake Detector stack.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "type": "row",
      "title": "Live logs",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": []
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "type": "logs",
      "title": "Backend (FastAPI)",
      "id": 1,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 1 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "expr": "{service=\"backend\"}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "type": "logs",
      "title": "Worker (Celery)",
      "id": 2,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 1 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "expr": "{service=\"worker\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Error rate",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 200,
      "panels": []
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "type": "timeseries",
      "title": "Errors per minute (by service)",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "fillOpacity": 50,
            "axisPlacement": "auto"
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate({project=\"deepfake-detector\", level=\"error\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "type": "stat",
      "title": "Errors (last 1h)",
      "id": 4,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({project=\"deepfake-detector\", level=\"error\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "type": "stat",
      "title": "Containers shipping logs",
      "id": 5,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "count(count by (container) (count_over_time({project=\"deepfake-detector\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Auth & email events",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 300,
      "panels": []
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "type": "logs",
      "title": "Email pipeline (sent / failed)",
      "id": 6,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 21 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{service=\"backend\"} |~ \"email\\\\.(sent|send_failed|skipped_no_smtp)\"",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "type": "logs",
      "title": "Auth events (login, register, verify)",
      "id": 7,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 21 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{service=\"backend\"} |~ \"auth\\\\.|login_success|login_failure\"",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["deepfake-detector", "logs"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
