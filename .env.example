# =============================================================
# DeepFake Detector - Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit your real .env to git.
# =============================================================

# ---------- App ----------
APP_NAME=DeepFake Detector
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ---------- Security ----------
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30
# Email verification link validity (minutes). Default 1440 = 24 hours.
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
# When true (default), /auth/login rejects users whose is_verified=False.
# Set to false ONLY for offline local development without an SMTP server.
REQUIRE_EMAIL_VERIFICATION=true

# ---------- PostgreSQL ----------
# Two databases are configured side-by-side. Switch with one variable:
#
#   DB_TARGET=neon   -> use DATABASE_URL_NEON   (default; production-grade)
#   DB_TARGET=local  -> use DATABASE_URL_LOCAL  (Docker Postgres for dev)
#
# start.sh / start.ps1 reads DB_TARGET to decide whether to launch the local
# postgres container or skip it.
DB_TARGET=neon

# ---- Local Docker Postgres (used when DB_TARGET=local) ----
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=deepfake_pw
POSTGRES_DB=deepfake_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL_LOCAL=postgresql+psycopg2://deepfake:deepfake_pw@postgres:5432/deepfake_db

# ---- Neon Postgres (used when DB_TARGET=neon) ----
# Get this from the Neon dashboard -> Connection Details -> "Direct" host.
# Always keep ?sslmode=require at the end. Bare postgresql:// is fine — the
# engine auto-upgrades it to postgresql+psycopg2:// internally.
DATABASE_URL_NEON=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# ---- Optional manual override ----
# Set this only if you want to bypass the DB_TARGET switch entirely.
# DATABASE_URL=

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- MinIO ----------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deepfake-uploads
MINIO_SECURE=false

# ---------- ClamAV ----------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60

# ---------- Email (SMTP) ----------
# Required when REQUIRE_EMAIL_VERIFICATION=true (registration flow & password
# reset both depend on it). For Gmail, generate an App Password and put it in
# SMTP_PASSWORD — your normal account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@deepfake-detector.app
SMTP_TLS=true

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Plan Limits ----------
# Free trial: 1 free scan per day; beyond that the user spends pay-per-scan credits.
PLAN_FREE_DAILY=1
PLAN_FREE_MAX_FILE_MB=10
PLAN_PRO_DAILY=500
PLAN_PRO_MAX_FILE_MB=200
PLAN_ENTERPRISE_DAILY=10000
PLAN_ENTERPRISE_MAX_FILE_MB=2048

# ---------- Pay-per-scan Credits ----------
# 1 credit = 1 scan; flat global rate of 50 cents ($0.50) per credit.
CREDIT_PRICE_USD_CENTS=50
CREDIT_MIN_PURCHASE=10
CREDIT_MAX_PURCHASE=100000

# ---------- Rate Limiting ----------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=120

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------- Production-only (only needed when running docker-compose.prod.yml) ----------
REDIS_PASSWORD=
FLOWER_USER=admin
FLOWER_PASSWORD=

# ---------- Observability (only needed with docker-compose.observability.yml) ----------
# Grafana login at http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# Optional basic-auth for Dozzle (leave empty to disable auth — fine on localhost only)
DOZZLE_USERNAME=
DOZZLE_PASSWORD=
